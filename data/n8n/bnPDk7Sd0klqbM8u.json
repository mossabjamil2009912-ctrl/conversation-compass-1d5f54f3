   "id": "6ba90dd6-1a1e-4e63-af11-9a67441d717d",
   "name": "استقبال إشعار التطبيق",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    0
   ],
   "webhookId": "121d86ce-89f6-46e7-9915-a7e80558bd9d"
  },
  {
   "parameters": {
    "jsCode": "const PHONE_NUMBER_ID = '1243456698857049'; // ضع هنا Phone Number ID من لوحة ميتا\n\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body || item.json;\n  const to = String(b.to || '967773590979').replace(/[^0-9]/g, '');\n  const text = String(b.text || 'إشعار جديد من تطبيق ACTES');\n  const rawButtons = Array.isArray(b.buttons) && b.buttons.length\n    ? b.buttons\n    : [\n        { id: 'invoice_confirm', title: '✅ تأكيد الفاتورة' },\n        { id: 'invoice_cancel', title: '❌ إلغاء الفاتورة' },\n      ];\n  const buttons = rawButtons.slice(0, 3).map((btn) => ({\n    type: 'reply',\n    reply: {\n      id: String(btn.id).slice(0, 256),\n      title: String(btn.title).slice(0, 20),\n    },\n  }));\n\n  out.push({\n    json: {\n      phoneNumberId: PHONE_NUMBER_ID,\n      payload: {\n        messaging_product: 'whatsapp',\n        recipient_type: 'individual',\n        to,\n        type: 'interactive',\n        interactive: {\n          type: 'button',\n          body: { text: text.slice(0, 1024) },\n          action: { buttons },\n        },\n      },\n    },\n  });\n}\nreturn out;"
   },
   "id": "ddae5638-4811-4fc1-9936-3209f397ab5c",
   "name": "تجهيز رسالة الأزرار",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
