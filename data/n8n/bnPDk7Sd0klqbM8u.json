   "id": "803426db-f450-451c-9ff9-1b279cc58cb6",
   "name": "استقبال ضغطة الزر",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    560
   ],
   "webhookId": "fe533872-d7f7-4f5e-bd4b-2c15519a1c33"
  },
  {
   "parameters": {
    "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const body = item.json.body || item.json;\n  const entries = body.entry || [];\n  for (const e of entries) {\n    for (const ch of (e.changes || [])) {\n      const msgs = ch.value?.messages || [];\n      for (const m of msgs) {\n        const btn = m.interactive?.button_reply || m.interactive?.list_reply;\n        if (btn && btn.id) {\n          out.push({ json: { buttonId: String(btn.id), text: String(btn.title || '') } });\n        }\n      }\n    }\n  }\n}\nreturn out;"
   },
